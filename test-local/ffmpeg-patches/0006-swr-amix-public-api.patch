diff --git a/libswresample/swresample.h b/libswresample/swresample.h
index 052089a..0c4218c 100644
--- a/libswresample/swresample.h
+++ b/libswresample/swresample.h
@@ -579,6 +579,39 @@ int swr_convert_frame(SwrContext *swr,
  */
 int swr_config_frame(SwrContext *swr, const AVFrame *out, const AVFrame *in);
 
+/**
+ * Serialise the internal state of an initialised SwrContext into an opaque
+ * byte buffer. Intended for resuming a streaming resample across process /
+ * instance boundaries with bit-exact continuity.
+ *
+ * On success, *buf is set to a freshly av_malloc()ed buffer that the caller
+ * owns and must release with av_free(), and *size is set to its length.
+ * On failure *buf is NULL and *size is 0.
+ *
+ * The buffer format is the stable FFSA wire format (component
+ * FFSA_COMPONENT_ARESAMPLE = 0x0002). The configuration identifying
+ * (rates, formats, channel layouts, resampler options) is fingerprinted
+ * inside; swr_set_state() rejects blobs whose config does not match.
+ *
+ * Must be called on an initialised SwrContext (after swr_init()).
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ */
+int swr_get_state(struct SwrContext *s, uint8_t **buf, size_t *size);
+
+/**
+ * Restore previously-serialised SwrContext state into a freshly-initialised
+ * SwrContext. Must be called AFTER swr_init() and with all configuration
+ * (rates, formats, layouts, flags) matching the snapshot's.
+ *
+ * The restore is two-pass: the blob is fully validated (header, sizes,
+ * CRC, required atoms) before any target state is mutated.
+ *
+ * @return 0 on success, a negative AVERROR on failure. On failure the
+ *         SwrContext is left in its pre-call state.
+ */
+int swr_set_state(struct SwrContext *s, const uint8_t *buf, size_t size);
+
 /**
  * @}
