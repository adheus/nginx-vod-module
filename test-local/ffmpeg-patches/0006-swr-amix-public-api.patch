+/* ------------------------------------------- filter state snapshot API -- */
+
+int avfilter_get_filter_state(AVFilterContext *ctx,
+                              uint8_t **buf, size_t *size)
+{
+    if (!ctx || !buf || !size)
+        return AVERROR(EINVAL);
+    *buf = NULL;
+    *size = 0;
+    if (!ctx->filter || !ctx->filter->name)
+        return AVERROR(EINVAL);
+
+#if CONFIG_AMIX_FILTER
+    if (!strcmp(ctx->filter->name, "amix"))
+        return ff_amix_get_state(ctx, buf, size);
+#endif
+    return AVERROR(ENOSYS);
+}
+
+int avfilter_set_filter_state(AVFilterContext *ctx,
+                              const uint8_t *buf, size_t size)
+{
+    if (!ctx || !buf || !size)
+        return AVERROR(EINVAL);
+    if (!ctx->filter || !ctx->filter->name)
+        return AVERROR(EINVAL);
+
+#if CONFIG_AMIX_FILTER
+    if (!strcmp(ctx->filter->name, "amix"))
+        return ff_amix_set_state(ctx, buf, size);
+#endif
+    return AVERROR(ENOSYS);
+}
+
 static int default_filter_frame(AVFilterLink *link, AVFrame *frame)
 {
     return ff_filter_frame(link->dst->outputs[0], frame);
diff --git a/libavfilter/avfilter.h b/libavfilter/avfilter.h
index 02b58c4..ba1808f 100644
--- a/libavfilter/avfilter.h
+++ b/libavfilter/avfilter.h
@@ -557,6 +557,40 @@ int avfilter_insert_filter(AVFilterLink *link, AVFilterContext *filt,
  */
 const AVClass *avfilter_get_class(void);
 
+/**
+ * Serialise the internal state of a filter into an opaque byte buffer.
+ *
+ * Intended for resuming a streaming filter in a fresh filter instance with
+ * bit-exact continuity. The wire format is stable within a single
+ * libavfilter (major,minor,micro) release — see state_format.c (FFSA v1).
+ *
+ * On success *buf is set to a freshly av_malloc()ed buffer that the caller
+ * owns and must release with av_free(), and *size is set to its length.
+ * On failure *buf is NULL and *size is 0.
+ *
+ * Currently supported filters: "amix". All other filters return
+ * AVERROR(ENOSYS).
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ */
+int avfilter_get_filter_state(AVFilterContext *ctx,
+                              uint8_t **buf, size_t *size);
+
+/**
+ * Restore previously-serialised filter state into a freshly-configured
+ * filter. Must be called after the filter's output link has been
+ * configured (config_output). The configuration fingerprint inside the
+ * blob must match the target filter's; otherwise AVERROR(EINVAL) is
+ * returned and the target is left untouched.
+ *
+ * Currently supported filters: "amix". Other filters return
+ * AVERROR(ENOSYS).
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ */
+int avfilter_set_filter_state(AVFilterContext *ctx,
+                              const uint8_t *buf, size_t size);
+
 /**
