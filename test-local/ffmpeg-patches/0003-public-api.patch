diff --git a/libavcodec/avcodec.h b/libavcodec/avcodec.h
index 6824bfc..9f5b1d8 100644
--- a/libavcodec/avcodec.h
+++ b/libavcodec/avcodec.h
@@ -2545,6 +2545,47 @@ int avcodec_get_hw_frames_parameters(AVCodecContext *avctx,
                                      enum AVPixelFormat hw_pix_fmt,
                                      AVBufferRef **out_frames_ref);
 
+/**
+ * Serialise the internal state of an opened encoder into an opaque byte
+ * buffer. Intended for resuming a streaming encode in a fresh encoder
+ * instance with bit-exact continuity (e.g. per-segment HLS encoders).
+ *
+ * On success, *buf is set to a freshly av_malloc()ed buffer that the caller
+ * owns and must release with av_free(), and *size is set to its length in
+ * bytes. On failure, *buf is set to NULL and *size is set to 0.
+ *
+ * The buffer format is opaque but stable within a single libavcodec
+ * (major,minor,micro) release; see libavcodec/state_format.c (FFSA v1).
+ * For bit-exact results, producer and consumer SHOULD open the encoder
+ * with AV_CODEC_FLAG_BITEXACT and use the same FFmpeg build.
+ *
+ * Currently supported: AV_CODEC_ID_AAC (native encoder). Other codecs
+ * return AVERROR(ENOSYS).
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ */
+int avcodec_get_encoder_state(AVCodecContext *avctx,
+                              uint8_t **buf, size_t *size);
+
+/**
+ * Restore previously-serialised encoder state into a freshly-opened
+ * encoder. Must be called after avcodec_open2() and before the first
+ * avcodec_send_frame(). The blob's config fields (sample_rate,
+ * ch_layout, bit_rate, profile, flags, coder options) must match those
+ * of the target encoder exactly; otherwise AVERROR(EINVAL) is returned
+ * and the encoder is left in its freshly-opened state.
+ *
+ * The restore is two-pass: the blob is fully validated (header, sizes,
+ * CRC, required atoms) before any target state is mutated.
+ *
+ * Currently supported: AV_CODEC_ID_AAC. Other codecs return
+ * AVERROR(ENOSYS).
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ */
+int avcodec_set_encoder_state(AVCodecContext *avctx,
+                              const uint8_t *buf, size_t size);
+
 enum AVCodecConfig {
     AV_CODEC_CONFIG_PIX_FORMAT,     ///< AVPixelFormat, terminated by AV_PIX_FMT_NONE
     AV_CODEC_CONFIG_FRAME_RATE,     ///< AVRational, terminated by {0, 0}
