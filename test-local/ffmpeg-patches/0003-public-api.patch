index f1a65a9..20db28e 100644
--- a/libavcodec/encode.c
+++ b/libavcodec/encode.c
@@ -18,6 +18,8 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#include "config_components.h"
+
 #include "libavutil/avassert.h"
 #include "libavutil/channel_layout.h"
 #include "libavutil/emms.h"
@@ -31,11 +33,16 @@
 #include "avcodec.h"
 #include "avcodec_internal.h"
 #include "codec_desc.h"
+#include "codec_id.h"
 #include "codec_internal.h"
 #include "encode.h"
 #include "frame_thread_encoder.h"
 #include "internal.h"
 
+#if CONFIG_AAC_ENCODER
+#include "aacenc_state.h"
+#endif
+
 typedef struct EncodeContext {
     AVCodecInternal avci;
 
@@ -959,3 +966,43 @@ int ff_check_codec_matrices(AVCodecContext *avctx, unsigned types, uint16_t min,
     }
     return 0;
 }
+
+/* --------------------------------------- encoder state snapshot/restore -- */
+
+int avcodec_get_encoder_state(AVCodecContext *avctx,
+                              uint8_t **buf, size_t *size)
+{
+    if (!avctx || !buf || !size)
+        return AVERROR(EINVAL);
+    *buf = NULL;
+    *size = 0;
+    if (!av_codec_is_encoder(avctx->codec))
+        return AVERROR(EINVAL);
+
+    switch (avctx->codec_id) {
+#if CONFIG_AAC_ENCODER
+    case AV_CODEC_ID_AAC:
+        return ff_aac_encoder_get_state(avctx, buf, size);
+#endif
+    default:
+        return AVERROR(ENOSYS);
+    }
+}
+
+int avcodec_set_encoder_state(AVCodecContext *avctx,
+                              const uint8_t *buf, size_t size)
+{
+    if (!avctx || !buf || !size)
+        return AVERROR(EINVAL);
+    if (!av_codec_is_encoder(avctx->codec))
+        return AVERROR(EINVAL);
+
+    switch (avctx->codec_id) {
+#if CONFIG_AAC_ENCODER
+    case AV_CODEC_ID_AAC:
+        return ff_aac_encoder_set_state(avctx, buf, size);
+#endif
+    default:
+        return AVERROR(ENOSYS);
+    }
+}
