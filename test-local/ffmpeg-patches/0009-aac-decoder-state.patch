@@ -0,0 +1,44 @@
+/*
+ * AAC decoder state snapshot/restore — internal declarations (Phase 28).
+ *
+ * Mirror of libavcodec/aacenc_state.h for the decoder side.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef AVCODEC_AAC_AACDEC_STATE_H
+#define AVCODEC_AAC_AACDEC_STATE_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#include "libavcodec/avcodec.h"
+
+int ff_aac_decoder_get_state(AVCodecContext *avctx,
+                             uint8_t **buf, size_t *size);
+int ff_aac_decoder_set_state(AVCodecContext *avctx,
+                             const uint8_t *buf, size_t size);
+
+#endif /* AVCODEC_AAC_AACDEC_STATE_H */
diff --git a/libavcodec/avcodec.h b/libavcodec/avcodec.h
--- a/libavcodec/avcodec.h
+++ b/libavcodec/avcodec.h
@@ -2586,6 +2586,35 @@ int avcodec_get_encoder_state(AVCodecContext *avctx,
 int avcodec_set_encoder_state(AVCodecContext *avctx,
                               const uint8_t *buf, size_t size);

+/**
+ * Phase 28: serialise the current state of a decoder into a portable
+ * blob. Symmetric to avcodec_get_encoder_state. Captures the minimal
+ * cross-frame state needed so that a freshly-opened decoder, after
+ * avcodec_set_decoder_state, emits the same PCM as a continuous
+ * decoder would at the same timeline position — principally the IMDCT
+ * overlap buffer, window-sequence, and PNS random state.
+ *
+ * Currently supported: AV_CODEC_ID_AAC (native decoder, float build).
+ * Other codecs return AVERROR(ENOSYS).
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ *   AVERROR(EAGAIN) if the decoder has not yet allocated its channel
+ *   elements (no frames decoded yet).
+ */
+int avcodec_get_decoder_state(AVCodecContext *avctx,
+                              uint8_t **buf, size_t *size);
+
+/**
+ * Restore previously-serialised decoder state. Must be called after
+ * avcodec_open2() AND after the decoder has allocated its channel
+ * elements for the configured layout — typically after decoding one
+ * frame, or after set_state failing with EAGAIN on first call.
+ *
+ * @return 0 on success, a negative AVERROR on failure.
+ */
+int avcodec_set_decoder_state(AVCodecContext *avctx,
+                              const uint8_t *buf, size_t size);
+
 enum AVCodecConfig {
     AV_CODEC_CONFIG_PIX_FORMAT,     ///< AVPixelFormat, terminated by AV_PIX_FMT_NONE
     AV_CODEC_CONFIG_FRAME_RATE,     ///< AVRational, terminated by {0, 0}
diff --git a/libavcodec/decode.c b/libavcodec/decode.c
--- a/libavcodec/decode.c
+++ b/libavcodec/decode.c
@@ -2485,3 +2485,52 @@ end:
     av_exif_free(&ifd);
     return ret;
 }
+
+/* --------------------------------------- decoder state snapshot/restore -- */
+/* Phase 28: per-codec state APIs for decoders. Currently only the native
+ * AAC decoder implements this; other codecs return ENOSYS. */
+
+#include "config_components.h"
+
+#if CONFIG_AAC_DECODER
+#include "aac/aacdec_state.h"
+#endif
+
+int avcodec_get_decoder_state(AVCodecContext *avctx,
+                              uint8_t **buf, size_t *size)
+{
+    if (!avctx || !buf || !size)
+        return AVERROR(EINVAL);
+    *buf = NULL;
+    *size = 0;
+    if (!av_codec_is_decoder(avctx->codec))
+        return AVERROR(EINVAL);
+
+    switch (avctx->codec_id) {
+#if CONFIG_AAC_DECODER
+    case AV_CODEC_ID_AAC:
+        return ff_aac_decoder_get_state(avctx, buf, size);
+#endif
+    default:
+        return AVERROR(ENOSYS);
+    }
+}
+
+int avcodec_set_decoder_state(AVCodecContext *avctx,
+                              const uint8_t *buf, size_t size)
+{
+    if (!avctx || !buf || !size)
+        return AVERROR(EINVAL);
+    if (!av_codec_is_decoder(avctx->codec))
+        return AVERROR(EINVAL);
+
+    switch (avctx->codec_id) {
+#if CONFIG_AAC_DECODER
+    case AV_CODEC_ID_AAC:
+        return ff_aac_decoder_set_state(avctx, buf, size);
+#endif
+    default:
+        return AVERROR(ENOSYS);
+    }
+}
diff --git a/libavcodec/state_format.h b/libavcodec/state_format.h
--- a/libavcodec/state_format.h
+++ b/libavcodec/state_format.h
@@ -26,6 +26,7 @@
 #define FFSA_COMPONENT_AAC_ENCODER 0x0001
 #define FFSA_COMPONENT_ARESAMPLE   0x0002
 #define FFSA_COMPONENT_AMIX        0x0003
+#define FFSA_COMPONENT_AAC_DECODER 0x0004  /* Phase 28 */

 /* Atom flags (u16, per atom). */
 #define FFSA_ATOM_REQUIRED   (1u << 0)
@@ -62,6 +63,15 @@
 #define FFSA_AAC_PSY_COEF_MIN_SNR        0x0015
 #define FFSA_AAC_ICS_MAX_SFB             0x0016  /* Phase 27 */

+/* AAC decoder atom tags (component 0x0004) — Phase 28 */
+#define FFSA_AACDEC_SAVED                0x3001
+#define FFSA_AACDEC_IS_SAVED             0x3002
+#define FFSA_AACDEC_WINDOW_SEQUENCE      0x3003
+#define FFSA_AACDEC_USE_KB_WINDOW        0x3004
+#define FFSA_AACDEC_RANDOM_STATE         0x3005
+#define FFSA_AACDEC_ICS_MAX_SFB          0x3006  /* optional / reserved */
+
 /* Fixed sizes */
 #define FFSA_HEADER_SIZE 36
 #define FFSA_TRAILER_SIZE 4
