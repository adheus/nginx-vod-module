diff --git a/libavfilter/af_amix.c b/libavfilter/af_amix.c
index 082d69b..bb66de1 100644
--- a/libavfilter/af_amix.c
+++ b/libavfilter/af_amix.c
@@ -631,3 +631,425 @@ const FFFilter ff_af_amix = {
                       AV_SAMPLE_FMT_DBL, AV_SAMPLE_FMT_DBLP),
     .process_command = process_command,
 };
+
+/* ---------------------------------------------------------------- state --- */
+/* State snapshot / restore for af_amix. Accessors used by
+ * avfilter_{get,set}_filter_state via af_amix_state.h. Kept here so
+ * MixContext remains file-private.
+ *
+ * Wire format: FFSA component_id=0x0003, component_version=0x0001.
+ * Atoms (all REQUIRED):
+ *   0x2001 AMIX_INPUT_STATE         u8 × nb_inputs
+ *   0x2002 AMIX_SCALE_NORM          f32 × nb_inputs  (BE bit pattern)
+ *   0x2003 AMIX_NEXT_PTS            i64
+ *   0x2004 AMIX_FRAME_LIST_HEADER   i32 nb_frames + i32 nb_samples
+ *   0x2005 AMIX_FRAME_LIST_ENTRIES  { i32 nb_samples, u32 reserved=0, i64 pts }
+ *                                   × nb_frames
+ *   0x2006 AMIX_FIFO_SIZES          i32 × nb_inputs  (per-input queued samples)
+ *   0x2007 AMIX_FIFO_DATA           concatenated per-input planar audio data
+ *                                   with per-plane BE bit pattern for f32/f64
+ */
+
+#include "libavutil/version.h"
+#include "state_format.h"
+#include "af_amix_state.h"
+#include "version.h"
+
+#define AMIX_COMPONENT_VERSION 0x0001
+
+static uint64_t amix_compute_config_hash(const MixContext *s, const AVFilterLink *outlink)
+{
+    uint8_t buf[256];
+    size_t off = 0;
+    int i;
+    union { float f; uint32_t u; } fbits;
+
+    ff_ffsa_wr_u32be(buf + off, FFSA_COMPONENT_AMIX);      off += 4;
+    ff_ffsa_wr_u32be(buf + off, AMIX_COMPONENT_VERSION);   off += 4;
+    ff_ffsa_wr_u32be(buf + off, (uint32_t)s->nb_inputs);   off += 4;
+    ff_ffsa_wr_u32be(buf + off, (uint32_t)s->sample_rate); off += 4;
+    ff_ffsa_wr_u32be(buf + off, (uint32_t)s->nb_channels); off += 4;
+    ff_ffsa_wr_u32be(buf + off, (uint32_t)outlink->format);off += 4;
+    ff_ffsa_wr_u32be(buf + off, (uint32_t)s->duration_mode); off += 4;
+    ff_ffsa_wr_u32be(buf + off, (uint32_t)s->normalize);   off += 4;
+    fbits.f = s->dropout_transition;
+    ff_ffsa_wr_u32be(buf + off, fbits.u); off += 4;
+    for (i = 0; i < s->nb_inputs; i++) {
+        fbits.f = s->weights[i];
+        ff_ffsa_wr_u32be(buf + off, fbits.u); off += 4;
+    }
+    return ff_ffsa_sha256_prefix64(buf, off);
+}
+
+static uint32_t amix_compute_build_hash(void)
+{
+    const char *ident = av_version_info();
+    if (!ident)
+        return 0;
+    return ff_ffsa_crc32((const uint8_t *)ident, strlen(ident));
+}
+
+int ff_amix_get_state(AVFilterContext *ctx, uint8_t **out_buf, size_t *out_size)
+{
+    MixContext *s = ctx->priv;
+    AVFilterLink *outlink;
+    FFSAWriter w;
+    uint8_t tmp[32];
+    int ret;
+    int i;
+    int bps;
+    int planes;
+    enum AVSampleFormat fmt;
+
+    if (!ctx || !out_buf || !out_size)
+        return AVERROR(EINVAL);
+    *out_buf = NULL;
+    *out_size = 0;
+    if (!ctx->nb_outputs || !ctx->outputs[0])
+        return AVERROR(EINVAL);
+    outlink = ctx->outputs[0];
+    fmt     = outlink->format;
+    bps     = av_get_bytes_per_sample(fmt);
+    if (bps <= 0 || !s->fifos || !s->input_state || !s->scale_norm)
+        return AVERROR(EINVAL);
+    planes = s->planar ? s->nb_channels : 1;
+
+    ret = ff_ffsa_writer_begin(&w,
+                               FFSA_COMPONENT_AMIX,
+                               AMIX_COMPONENT_VERSION,
+                               LIBAVFILTER_VERSION_INT,
+                               amix_compute_build_hash(),
+                               amix_compute_config_hash(s, outlink),
+                               0);
+    if (ret < 0)
+        return ret;
+
+    /* 0x2001 AMIX_INPUT_STATE */
+    ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_INPUT_STATE,
+                                  FFSA_ATOM_REQUIRED,
+                                  s->input_state, (uint32_t)s->nb_inputs);
+    if (ret < 0) goto fail;
+
+    /* 0x2002 AMIX_SCALE_NORM */
+    {
+        uint32_t total = (uint32_t)s->nb_inputs * 4;
+        uint8_t *payload = av_malloc(total);
+        if (!payload) { ret = AVERROR(ENOMEM); goto fail; }
+        for (i = 0; i < s->nb_inputs; i++)
+            ff_ffsa_wr_f32be(payload + i * 4, s->scale_norm[i]);
+        ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_SCALE_NORM,
+                                      FFSA_ATOM_REQUIRED, payload, total);
+        av_free(payload);
+        if (ret < 0) goto fail;
+    }
+
+    /* 0x2003 AMIX_NEXT_PTS */
+    ff_ffsa_wr_u64be(tmp, (uint64_t)s->next_pts);
+    ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_NEXT_PTS,
+                                  FFSA_ATOM_REQUIRED, tmp, 8);
+    if (ret < 0) goto fail;
+
+    /* 0x2004 AMIX_FRAME_LIST_HEADER + 0x2005 ENTRIES */
+    {
+        int nb_frames  = s->frame_list ? s->frame_list->nb_frames  : 0;
+        int nb_samples = s->frame_list ? s->frame_list->nb_samples : 0;
+        uint8_t header[8];
+        ff_ffsa_wr_u32be(header + 0, (uint32_t)nb_frames);
+        ff_ffsa_wr_u32be(header + 4, (uint32_t)nb_samples);
+        ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_FRAME_LIST_HEADER,
+                                      FFSA_ATOM_REQUIRED, header, 8);
+        if (ret < 0) goto fail;
+
+        {
+            uint32_t entries_len = (uint32_t)nb_frames * 16;
+            uint8_t *entries = entries_len ? av_malloc(entries_len) : NULL;
+            FrameInfo *fi;
+            if (entries_len && !entries) { ret = AVERROR(ENOMEM); goto fail; }
+            fi = s->frame_list ? s->frame_list->list : NULL;
+            for (i = 0; i < nb_frames; i++) {
+                if (!fi) { av_free(entries); ret = AVERROR(EINVAL); goto fail; }
+                ff_ffsa_wr_u32be(entries + i * 16 + 0, (uint32_t)fi->nb_samples);
+                ff_ffsa_wr_u32be(entries + i * 16 + 4, 0);
+                ff_ffsa_wr_u64be(entries + i * 16 + 8, (uint64_t)fi->pts);
+                fi = fi->next;
+            }
+            ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_FRAME_LIST_ENTRIES,
+                                          FFSA_ATOM_REQUIRED,
+                                          entries, entries_len);
+            av_free(entries);
+            if (ret < 0) goto fail;
+        }
+    }
+
+    /* 0x2006 AMIX_FIFO_SIZES */
+    {
+        uint32_t total = (uint32_t)s->nb_inputs * 4;
+        uint8_t *payload = av_malloc(total);
+        if (!payload) { ret = AVERROR(ENOMEM); goto fail; }
+        for (i = 0; i < s->nb_inputs; i++) {
+            int size = av_audio_fifo_size(s->fifos[i]);
+            ff_ffsa_wr_u32be(payload + i * 4, (uint32_t)size);
+        }
+        ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_FIFO_SIZES,
+                                      FFSA_ATOM_REQUIRED, payload, total);
+        av_free(payload);
+        if (ret < 0) goto fail;
+    }
+
+    /* 0x2007 AMIX_FIFO_DATA — concatenated per-input planar audio.
+     * For planar formats AVAudioFifo stores each channel in a separate
+     * sub-fifo; peek writes into data[0..nb_channels-1]. For packed it
+     * writes a single interleaved stream into data[0]. */
+    {
+        uint32_t total_bytes = 0;
+        uint8_t *payload;
+        int off_b = 0;
+        int p;
+        for (i = 0; i < s->nb_inputs; i++) {
+            int size = av_audio_fifo_size(s->fifos[i]);
+            total_bytes += (uint32_t)size * bps * s->nb_channels;
+        }
+        payload = total_bytes ? av_malloc(total_bytes) : NULL;
+        if (total_bytes && !payload) { ret = AVERROR(ENOMEM); goto fail; }
+        for (i = 0; i < s->nb_inputs; i++) {
+            int size = av_audio_fifo_size(s->fifos[i]);
+            int bytes_per_plane;
+            uint8_t *scratch;
+            uint8_t **ptrs;
+            int peek;
+            if (size <= 0)
+                continue;
+            bytes_per_plane = size * bps * (s->planar ? 1 : s->nb_channels);
+            scratch = av_malloc((size_t)planes * (size_t)bytes_per_plane);
+            if (!scratch) { av_free(payload); ret = AVERROR(ENOMEM); goto fail; }
+            ptrs = av_calloc(planes, sizeof(*ptrs));
+            if (!ptrs) { av_free(scratch); av_free(payload); ret = AVERROR(ENOMEM); goto fail; }
+            for (p = 0; p < planes; p++)
+                ptrs[p] = scratch + (size_t)p * bytes_per_plane;
+            peek = av_audio_fifo_peek(s->fifos[i], (void **)ptrs, size);
+            if (peek != size) {
+                av_free(scratch); av_free(ptrs); av_free(payload);
+                ret = AVERROR(EINVAL); goto fail;
+            }
+            /* Endian-convert and append to payload. */
+            {
+                int elem;
+                int total_elems;
+                if (fmt == AV_SAMPLE_FMT_FLTP || fmt == AV_SAMPLE_FMT_DBLP ||
+                    fmt == AV_SAMPLE_FMT_FLT  || fmt == AV_SAMPLE_FMT_DBL) {
+                    total_elems = bytes_per_plane / bps;
+                    for (p = 0; p < planes; p++) {
+                        for (elem = 0; elem < total_elems; elem++) {
+                            if (bps == 4) {
+                                uint32_t v;
+                                memcpy(&v, ptrs[p] + elem * 4, 4);
+                                ff_ffsa_wr_u32be(payload + off_b, v);
+                                off_b += 4;
+                            } else { /* bps == 8 */
+                                uint64_t v;
+                                memcpy(&v, ptrs[p] + elem * 8, 8);
+                                ff_ffsa_wr_u64be(payload + off_b, v);
+                                off_b += 8;
+                            }
+                        }
+                    }
+                } else {
+                    av_free(scratch); av_free(ptrs); av_free(payload);
+                    ret = AVERROR(EINVAL); goto fail;
+                }
+            }
+            av_free(scratch);
+            av_free(ptrs);
+        }
+        ret = ff_ffsa_writer_add_atom(&w, FFSA_AMIX_FIFO_DATA,
+                                      FFSA_ATOM_REQUIRED,
+                                      payload, total_bytes);
+        av_free(payload);
+        if (ret < 0) goto fail;
+    }
+
+    ret = ff_ffsa_writer_finish(&w, out_buf, out_size);
+    if (ret < 0)
+        goto fail;
+    return 0;
+
+fail:
+    ff_ffsa_writer_abort(&w);
+    *out_buf = NULL;
+    *out_size = 0;
+    return ret;
+}
+
+int ff_amix_set_state(AVFilterContext *ctx, const uint8_t *buf, size_t size)
+{
+    MixContext *s = ctx->priv;
+    AVFilterLink *outlink;
+    FFSAReader r;
+    const uint8_t *val;
+    uint32_t vlen;
+    int ret;
+    int i;
+    int bps;
+    int planes;
+    enum AVSampleFormat fmt;
+
+    if (!ctx || !buf || !size)
+        return AVERROR(EINVAL);
+    if (!ctx->nb_outputs || !ctx->outputs[0])
+        return AVERROR(EINVAL);
+    outlink = ctx->outputs[0];
+    fmt     = outlink->format;
+    bps     = av_get_bytes_per_sample(fmt);
+    if (bps <= 0 || !s->fifos)
+        return AVERROR(EINVAL);
+    planes = s->planar ? s->nb_channels : 1;
+
+    ret = ff_ffsa_reader_validate(&r, buf, size);
+    if (ret < 0)
+        return ret;
+    if (r.header.component_id != FFSA_COMPONENT_AMIX)
+        return AVERROR(EINVAL);
+    if (r.header.component_version != AMIX_COMPONENT_VERSION)
+        return AVERROR(EINVAL);
+    if (r.header.config_hash != amix_compute_config_hash(s, outlink))
+        return AVERROR(EINVAL);
+
+    /* pass 1: all size checks */
+    if (!ff_ffsa_reader_find(&r, FFSA_AMIX_INPUT_STATE, &val, &vlen) ||
+        vlen != (uint32_t)s->nb_inputs)
+        return AVERROR(EINVAL);
+    if (!ff_ffsa_reader_find(&r, FFSA_AMIX_SCALE_NORM, &val, &vlen) ||
+        vlen != (uint32_t)s->nb_inputs * 4)
+        return AVERROR(EINVAL);
+    if (!ff_ffsa_reader_find(&r, FFSA_AMIX_NEXT_PTS, &val, &vlen) || vlen != 8)
+        return AVERROR(EINVAL);
+    if (!ff_ffsa_reader_find(&r, FFSA_AMIX_FRAME_LIST_HEADER, &val, &vlen) ||
+        vlen != 8)
+        return AVERROR(EINVAL);
+    {
+        uint32_t nb_frames = ff_ffsa_rd_u32be(val);
+        const uint8_t *fv;
+        uint32_t fl;
+        if (!ff_ffsa_reader_find(&r, FFSA_AMIX_FRAME_LIST_ENTRIES, &fv, &fl))
+            return AVERROR(EINVAL);
+        if (fl != nb_frames * 16)
+            return AVERROR(EINVAL);
+    }
+    if (!ff_ffsa_reader_find(&r, FFSA_AMIX_FIFO_SIZES, &val, &vlen) ||
+        vlen != (uint32_t)s->nb_inputs * 4)
+        return AVERROR(EINVAL);
+    {
+        /* compute expected FIFO_DATA size */
+        const uint8_t *sv;
+        uint32_t sl;
+        uint32_t expect = 0;
+        ff_ffsa_reader_find(&r, FFSA_AMIX_FIFO_SIZES, &sv, &sl);
+        for (i = 0; i < s->nb_inputs; i++) {
+            uint32_t n = ff_ffsa_rd_u32be(sv + i * 4);
+            expect += n * (uint32_t)bps * (uint32_t)s->nb_channels;
+        }
+        if (!ff_ffsa_reader_find(&r, FFSA_AMIX_FIFO_DATA, &val, &vlen))
+            return AVERROR(EINVAL);
+        if (vlen != expect)
+            return AVERROR(EINVAL);
+    }
+
+    /* pass 2: apply */
+    ff_ffsa_reader_find(&r, FFSA_AMIX_INPUT_STATE, &val, &vlen);
+    memcpy(s->input_state, val, (size_t)s->nb_inputs);
+
+    ff_ffsa_reader_find(&r, FFSA_AMIX_SCALE_NORM, &val, &vlen);
+    for (i = 0; i < s->nb_inputs; i++)
+        s->scale_norm[i] = ff_ffsa_rd_f32be(val + i * 4);
+
+    ff_ffsa_reader_find(&r, FFSA_AMIX_NEXT_PTS, &val, &vlen);
+    s->next_pts = (int64_t)ff_ffsa_rd_u64be(val);
+
+    /* Rebuild frame_list */
+    if (!s->frame_list) {
+        s->frame_list = av_mallocz(sizeof(*s->frame_list));
+        if (!s->frame_list)
+            return AVERROR(ENOMEM);
+    } else {
+        frame_list_clear(s->frame_list);
+    }
+    ff_ffsa_reader_find(&r, FFSA_AMIX_FRAME_LIST_HEADER, &val, &vlen);
+    {
+        uint32_t nb_frames  = ff_ffsa_rd_u32be(val + 0);
+        uint32_t nb_samples = ff_ffsa_rd_u32be(val + 4);
+        const uint8_t *fv;
+        uint32_t fl;
+        ff_ffsa_reader_find(&r, FFSA_AMIX_FRAME_LIST_ENTRIES, &fv, &fl);
+        for (i = 0; i < (int)nb_frames; i++) {
+            int s_n = (int32_t)ff_ffsa_rd_u32be(fv + i * 16 + 0);
+            int64_t s_p = (int64_t)ff_ffsa_rd_u64be(fv + i * 16 + 8);
+            int r2 = frame_list_add_frame(s->frame_list, s_n, s_p);
+            if (r2 < 0)
+                return r2;
+        }
+        (void)nb_samples; /* nb_samples is derived; we assert via frame_list */
+    }
+
+    /* Rebuild FIFOs: reset + write back peeked data. */
+    {
+        const uint8_t *sv;
+        uint32_t sl;
+        const uint8_t *dv;
+        uint32_t dl;
+        int off_b = 0;
+        int p;
+        ff_ffsa_reader_find(&r, FFSA_AMIX_FIFO_SIZES, &sv, &sl);
+        ff_ffsa_reader_find(&r, FFSA_AMIX_FIFO_DATA, &dv, &dl);
+        for (i = 0; i < s->nb_inputs; i++) {
+            int n = (int32_t)ff_ffsa_rd_u32be(sv + i * 4);
+            int bytes_per_plane;
+            uint8_t *scratch;
+            uint8_t **ptrs;
+            int r2;
+            av_audio_fifo_reset(s->fifos[i]);
+            if (n <= 0)
+                continue;
+            bytes_per_plane = n * bps * (s->planar ? 1 : s->nb_channels);
+            scratch = av_malloc((size_t)planes * (size_t)bytes_per_plane);
+            if (!scratch)
+                return AVERROR(ENOMEM);
+            ptrs = av_calloc(planes, sizeof(*ptrs));
+            if (!ptrs) { av_free(scratch); return AVERROR(ENOMEM); }
+            {
+                int elem;
+                int total_elems = bytes_per_plane / bps;
+                for (p = 0; p < planes; p++) {
+                    ptrs[p] = scratch + (size_t)p * bytes_per_plane;
+                    for (elem = 0; elem < total_elems; elem++) {
+                        if (bps == 4) {
+                            uint32_t v = ff_ffsa_rd_u32be(dv + off_b);
+                            memcpy(ptrs[p] + elem * 4, &v, 4);
+                            off_b += 4;
+                        } else {
+                            uint64_t v = ff_ffsa_rd_u64be(dv + off_b);
+                            memcpy(ptrs[p] + elem * 8, &v, 8);
+                            off_b += 8;
+                        }
+                    }
+                }
+            }
+            r2 = av_audio_fifo_write(s->fifos[i], (void **)ptrs, n);
+            av_free(scratch);
+            av_free(ptrs);
+            if (r2 < 0)
+                return r2;
+            if (r2 != n)
+                return AVERROR(ENOMEM);
+        }
+    }
+
+    /* Recompute active_inputs from restored input_state. */
+    {
+        int active = 0;
+        for (i = 0; i < s->nb_inputs; i++)
+            active += !!(s->input_state[i] & INPUT_ON);
+        s->active_inputs = active;
+    }
+
+    return 0;
+}
