+#ifndef AVCODEC_AACENC_STATE_H
+#define AVCODEC_AACENC_STATE_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#include "avcodec.h"
+
+/* Public-API backing. Callers: avcodec_{get,set}_encoder_state. */
+int ff_aac_encoder_get_state(AVCodecContext *avctx,
+                             uint8_t **buf, size_t *size);
